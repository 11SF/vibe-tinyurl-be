# Application Configuration
APP_NAME=tinyurl
APP_PORT=8080
BASE_URL=https://your-domain.com

# Database Configuration
DB_DSN=postgres://username:password@localhost:5432/tinyurl?sslmode=disable

# Redis Configuration
